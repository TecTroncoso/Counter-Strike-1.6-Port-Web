// Wrangler config for the Cloudflare deployment via OpenNext.
// https://opennext.js/cloudflare
//
// Build + deploy:  bun run deploy:cf   (package.json)
// Local preview:   bun run build:cf && bunx opennextjs-cloudflare preview
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cs16-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  // Required by the OpenNext worker (node:async_hooks, streams, etc).
  "compatibility_flags": ["nodejs_compat"],
  // Static assets generated by OpenNext (Next.js public/ + _next/static).
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
  // NOTE: the big CS 1.6 game files are NOT deployed as Worker assets
  // (25 MB/file limit; several files are near it). They live in a public R2
  // bucket instead — see scripts/upload_r2.sh — and the frontend reaches them
  // through NEXT_PUBLIC_ASSETS_BASE_URL. No R2 binding is needed by the worker.
  //
  // "r2_buckets": [
  //   { "binding": "ASSETS_BUCKET", "bucket_name": "cs16-assets" }
  // ]
}
