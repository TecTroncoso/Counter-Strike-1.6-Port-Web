# =============================================================================
# Variables de entorno para el despliegue Cloudflare + Render + Turso
# Copia este archivo a .env (frontend) y configura los valores reales.
# NUNCA hagas commit de .env con tokens reales.
# =============================================================================

# ---------------------------------------------------------------------------
# 1. Frontend (Cloudflare Workers / Pages — build time para las NEXT_PUBLIC_*)
# ---------------------------------------------------------------------------

# URL pública del puente WebSocket en Render (sin barra final).
# El frontend la usa para el túnel WSS y para consultar /health.
# No existe un endpoint /logs público: los logs están en el dashboard de Render.
NEXT_PUBLIC_CS16_BRIDGE_URL=wss://cs16-hlds-bridge.onrender.com

# URL pública del bucket R2 con los archivos del juego (271 MB subidos con
# scripts/upload_r2.sh). Sin barra final. Ejemplos:
#   https://pub-xxxxxxxx.r2.dev                (endpoint r2.dev, solo dev)
#   https://assets.tu-dominio.com              (dominio custom en el bucket, prod)
NEXT_PUBLIC_ASSETS_BASE_URL=https://pub-xxxxxxxx.r2.dev

# ---------------------------------------------------------------------------
# 2. Base de datos (Turso / libSQL) — runtime, en el Worker y en local
# ---------------------------------------------------------------------------
# turso db create cs16  →  copia aquí la URL de la base de datos
TURSO_DATABASE_URL=libsql://cs16-tuusuario.turso.io
# turso db tokens create cs16
TURSO_AUTH_TOKEN=eyJ...

# ---------------------------------------------------------------------------
# 3. Local (sandbox / VPS single-box) — no tocar para modo dev
# ---------------------------------------------------------------------------
# Si TURSO_DATABASE_URL está definido, src/lib/db.ts usa Turso.
# Si NO está definido, usa el SQLite local (DATABASE_URL) como siempre.
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ---------------------------------------------------------------------------
# 4. Render (puente + HLDS) — definidos en deploy/render/render.yaml
# ---------------------------------------------------------------------------
# PORT              → Render lo inyecta (10000)
# HLDS_DIR          → /app
# HLDS_GAME_DIR     → /app/cstrike
# HLDS_LOG_FILE     → /tmp/hlds-supervised.log
# HLDS_MAP          → de_dust2
# HLDS_MAXPLAYERS   → 16
# HLDS_BOT_QUOTA    → 9 (0–32)
# QEMU              → "" (vacío: HLDS nativo 32-bit, Render es x86_64)
# BRIDGE_ALLOWED_ORIGINS → Render lo solicita al aplicar el Blueprint.
#   Usa el origen exacto del frontend, separado por comas si hay varios:
#   https://cs16-web.tu-subdomain.workers.dev,https://jugar.tudominio.com
# HLDS_RCON_PASSWORD → Render lo genera como secreto. No lo pongas en este
#   archivo .env del frontend ni lo compartas con el navegador.
