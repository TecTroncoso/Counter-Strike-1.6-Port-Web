# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.open-next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit real secrets; keep the deployment template)
.env*
!.env.deploy.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Local OpenNext/Wrangler output
/.wrangler/
/.wrangler-dry-run/
# Skills directory
/skills/
# CS 1.6 big binary assets (Tailwind scanner must ignore)
public/valve-parts/
public/engine/

# Local game assets: keep them out of GitHub and upload them to R2 separately.
# They are licensed game data and are not meant to be redistributed.
game-files/

# Generated E2E screenshots (keep the test scripts, not their output)
scripts/*.png

# Local Python virtual environment
venv/
