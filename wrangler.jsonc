// Wrangler config for the Cloudflare deployment via OpenNext.
// https://opennext.js/cloudflare
//
// Build + deploy:  bun run deploy:cf   (package.json)
// Local preview:   bun run build:cf && bunx opennextjs-cloudflare preview
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cs16-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  // Required by the OpenNext worker (node:async_hooks, streams, etc).
  "compatibility_flags": ["nodejs_compat"],
  // Static assets generated by OpenNext (Next.js public/ + _next/static), plus
  // the CS 1.6 game files copied by scripts/prepare-cloudflare-assets.mjs.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
  // The current game-file set is 42 files (about 284 MB total); its largest
  // file is below Cloudflare's 25 MiB per-file limit. R2 can still be used as
  // an external origin for resumable Range downloads by setting
  // NEXT_PUBLIC_ASSETS_BASE_URL; no R2 binding is needed by the Worker.
  //
  // "r2_buckets": [
  //   { "binding": "ASSETS_BUCKET", "bucket_name": "cs16-assets" }
  // ]
}
